# The crates.io crates the Rust targets link, one target per crate, GENERATED by
# `kpin cargo` (komira: tools/build/kpin/README.md, "Cargo") into crates.bzl from
#
#   Cargo.toml                 what Cargo is asked to resolve (hand-written)
#   Cargo.lock                 what a GitHub runner resolved: the sha256 of every .crate
#   cargo/metadata.json        `cargo metadata`, trimmed: the graph, features, renames
#   cargo/sizes.txt            the size of every .crate
#   cargo/overrides.json       what each build script decides for the pinned rustc
#
# Nobody edits crates.bzl. `:crates_gen` writes it and fails unless the committed
# file is exactly that: a hand edit, a stale file, a changed input, or a compiler bump
# that left the overrides behind is a red build (see README.md).
load("@komira//tools/build/kpin:cargo.bzl", "kpin_cargo")
load(":crates.bzl", "crates")

kpin_cargo(
    name = "crates_gen",
    cargo_lock = "Cargo.lock",
    cargo_metadata = "cargo/metadata.json",
    committed = "crates.bzl",
    overrides = "cargo/overrides.json",
    sizes = "cargo/sizes.txt",
)

crates()

# This package's files, for //:hygiene (a package boundary hides them from the root
# package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
