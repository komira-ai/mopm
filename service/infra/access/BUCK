# The access stack's checks (see service/api/BUCK): `tsc --noEmit` and `jest --ci`. The
# bootstrap and oauth-secret shell tests stay in service-ci.yml.

load("@buildrules//rules/node:modules.bzl", "jest_test", "npm_modules", "tsc_check")
load(":pins.lock.bzl", "NPM")

_NODE = "//tools/node:node"

# The shell scripts are not run here (service-ci.yml does); a test reads bootstrap.sh and
# BOOTSTRAP.md as text for the public-repo hygiene check.
_SRCS = glob(["bin/**", "lib/**", "test/**"], exclude = ["test/*.sh"]) + [
    "BOOTSTRAP.md",
    "bootstrap.sh",
    "cdk.json",
    "cfn-exec-policy.template.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

jest_test(
    name = "test",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# The managed policy template the stacks' tests check their grants against
# (cfn-exec-coverage.test.ts).
export_file(
    name = "cfn-exec-policy.template.json",
    visibility = ["//service/infra/stacks:"],
)

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["cdk.out/**", "**/*.js", "**/*.d.ts", "cdk.context.json"]) + [".gitignore", "jest.config.js"],
    copy = True,
    visibility = ["//:"],
)
