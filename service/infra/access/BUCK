# The access stack's checks (see service/api/BUCK): `tsc --noEmit` and `jest --ci`. The held commands
# (bootstrap, oauth-secret) are TypeScript under bin/ and lib/, tested by test/*.test.ts against a fake host.

load("@buildrules//rules/node:modules.bzl", "npm_modules", "tsc_check")
load("//vendor/buildrules_coverage:jest_cover.bzl", "jest_coverage_floor", "jest_test")
load(":pins.lock.bzl", "NPM")

_NODE = "//tools/node:node"

# The hygiene test reads the sources and BOOTSTRAP.md as text, and the bootstrap test reads the policy template.
_SRCS = glob(["bin/**", "lib/**", "test/**"]) + [
    "BOOTSTRAP.md",
    "cdk.json",
    "cfn-exec-policy.template.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

jest_test(
    name = "test",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# The lines and branches of the package's own code that the tests above reach (jest --coverage), held to coverage_floor.txt (vendor/buildrules_coverage/README.md).
jest_coverage_floor()

# The managed policy template the stacks' tests check their grants against
# (cfn-exec-coverage.test.ts).
export_file(
    name = "cfn-exec-policy.template.json",
    visibility = ["//service/infra/stacks:"],
)

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["cdk.out/**", "**/*.js", "**/*.d.ts", "cdk.context.json"]) + [".gitignore", "jest.config.js"],
    copy = True,
    visibility = ["//:"],
)
