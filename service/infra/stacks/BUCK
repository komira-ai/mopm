# The service stacks' checks (see service/api/BUCK): `tsc --noEmit`, `jest --ci`, and
# `cdk synth` of every stage with a dummy account and zone id, as in service-ci.yml.
# The tests read eight things outside this package (the API specification is the fifth, the stage_settings item the Rust
# side parses the sixth, the web-session function's table grants the seventh, the tutorial sandbox function's grants the
# eighth), which are `data` at their paths
# in the repository: the access stack's policy template, the API's golden grants and
# recorded wire goldens, and the stages' configuration; the synths also take the API handler bundle (service/api:dist).
# The site stack deploys the site build (//site:dist, at site/dist), generates its edge router
# from the site's route grammar (site/src/routes.ts), takes its security headers from the site's
# (site/tools/headers.ts), takes the header's Tutorial entry out of the pages of a stage that does not
# serve the tutorial (site/tools/tutorial-link.ts) and is tested against the site's route vectors
# (site/test/fixtures/routes.json).

load("@buildrules//rules/node:modules.bzl", "cdk_synth", "jest_test", "npm_modules", "tsc_check")
load("@buildrules//rules/coverage:jest_cover.bzl", "jest_coverage_floor")
load("//tools/lambda:lambda.bzl", "lambda_bundle")
load(":pins.lock.bzl", "NPM")

_NODE = "//tools/node:node"

_SRCS = glob(["bin/**", "lib/**", "test/**"]) + [
    "cdk.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

_DATA = {
    "service/api/dist": "//service/api:dist",
    "service/api/src/group.ts": "//service/api:src_group.ts",
    "service/api/src/group-store.ts": "//service/api:src_group-store.ts",
    "service/api/src/metrics.ts": "//service/api:src_metrics.ts",
    "service/api/src/publish/config.ts": "//service/api:src_config.ts",
    "service/api/src/publish/group-service.ts": "//service/api:src_group-service.ts",
    "service/api/src/publish/group-sweeper.ts": "//service/api:src_group-sweeper.ts",
    "service/api/src/validate/native-mirror.ts": "//service/api:src_native-mirror.ts",
    "service/api/test/fixtures/group-inventory.json": "//service/api:group-inventory.json",
    "service/api/test/fixtures/lambda-auth-grants.json": "//service/api:lambda-auth-grants.json",
    "service/api/test/fixtures/wire": "//service/api:wire_goldens",
    "service/lambda/fn_web_login/tests/fixtures/role_grants.json": "//service/lambda/fn_web_login:role_grants.json",
    "service/config/beta.json": "//service/config:beta.json",
    "service/config/gamma.json": "//service/config:gamma.json",
    "service/config/prod.json": "//service/config:prod.json",
    "service/infra/access/cfn-exec-policy.template.json": "//service/infra/access:cfn-exec-policy.template.json",
    "service/lambda/fn_tutorial_sandbox/tests/fixtures/grants.json": "//service/lambda/fn_tutorial_sandbox:grants.json",
    "service/lambda/testing/tests/fixtures/web_session_grants.json": "//service/lambda/testing:web_session_grants.json",
    "service/lambda/web/tests/fixtures/stage_settings_item.json": "//service/lambda/web:stage_settings_item.json",
    "site/dist": "//site:dist",
    "site/src/routes.ts": "//site:routes.ts",
    "site/tools/headers.ts": "//site:headers.ts",
    "site/tools/tutorial-link.ts": "//site:tutorial-link.ts",
    "site/test/fixtures/routes.json": "//site:routes.json",
    "spec": "//:spec",
}

# cdk.json's app, `npx ts-node --prefer-ts-exts bin/stacks.ts`, without npx (there is no npm).
_APP = "node node_modules/.bin/ts-node --prefer-ts-exts bin/stacks.ts"

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    data = _DATA,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

jest_test(
    name = "test",
    coverage = True,
    data = _DATA,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# The lines and branches of the package's own code that the tests above reach (jest --coverage), held to coverage_floor.txt (buildrules' rules/coverage/README.md).
jest_coverage_floor()

[cdk_synth(
    name = "synth_" + stage,
    app = _APP,
    context = {
        "commit": "ci",
        "hostedZoneId": "Z0DUMMYZONE",
        "stage": stage,
        "version": "ci",
    },
    data = _DATA,
    env = {
        "CDK_DEFAULT_ACCOUNT": "1" * 12,
        "CDK_DEFAULT_REGION": "us-east-1",
    },
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
) for stage in ["beta", "gamma", "prod"]]

# The three Rust functions' zips and their sums in one directory. The promote workflow's function-zips job builds it once per
# commit, and deploy.yml passes the downloaded directory to the app as the context `rustZipDir`.
lambda_bundle(
    name = "function_zips",
    zips = {
        "tutorial-sandbox": "//service/lambda/fn_tutorial_sandbox:zip",
        "web-login": "//service/lambda/fn_web_login:zip",
        "web-session": "//service/lambda/fn_web_session:zip",
    },
    visibility = ["PUBLIC"],
)

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["cdk.out/**", "**/*.js", "**/*.d.ts", "cdk.context.json"]) + [".gitignore", "jest.config.js"],
    copy = True,
    visibility = ["//:"],
)

# The sources that name the queues and the alarms the runbook states (site/test/docs-group.test.ts), and those of the
# retention and timeout docs/what-mopm-stores.md states.
[export_file(
    name = "site_" + name,
    src = path,
    mode = "reference",
    visibility = ["//site:"],
) for name, path in {
    "config.ts": "lib/config.ts",
    "publish-stack.ts": "lib/publish-stack.ts",
    # What docs/what-mopm-stores.md states (site/test/docs-stores.test.ts): the log retention, the sandbox timeout, the
    # two-factor default and the tables' backups and encryption.
    "api-stack.ts": "lib/api-stack.ts",
    "app.ts": "lib/app.ts",
    "data-stack.ts": "lib/data-stack.ts",
    "rust-function.ts": "lib/rust-function.ts",
    "stage-settings.ts": "lib/stage-settings.ts",
}.items()]
