# The service stacks' checks (see service/api/BUCK): `tsc --noEmit`, `jest --ci`, and
# `cdk synth` of every stage with a dummy account and zone id, as in service-ci.yml.
# The tests read five things outside this package (the API specification is the fifth), which are `data` at their paths
# in the repository: the access stack's policy template, the API's golden grants and
# recorded wire goldens, and the stages' configuration; the synths also take the API handler bundle (service/api:dist).
# The site stack deploys the site build (//site:dist, at site/dist), generates its edge router
# from the site's route grammar (site/src/routes.ts) and is tested against the site's route
# vectors (site/test/fixtures/routes.json).

load("@buildrules//rules/node:modules.bzl", "cdk_synth", "npm_modules", "tsc_check")
load("//vendor/buildrules_coverage:jest_cover.bzl", "jest_coverage_floor", "jest_test")
load(":pins.lock.bzl", "NPM")

_NODE = "//tools/node:node"

_SRCS = glob(["bin/**", "lib/**", "test/**"]) + [
    "cdk.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

_DATA = {
    "service/api/dist": "//service/api:dist",
    "service/api/src/group.ts": "//service/api:src_group.ts",
    "service/api/src/group-store.ts": "//service/api:src_group-store.ts",
    "service/api/src/metrics.ts": "//service/api:src_metrics.ts",
    "service/api/src/publish/group-service.ts": "//service/api:src_group-service.ts",
    "service/api/src/publish/group-sweeper.ts": "//service/api:src_group-sweeper.ts",
    "service/api/test/fixtures/group-inventory.json": "//service/api:group-inventory.json",
    "service/api/test/fixtures/lambda-auth-grants.json": "//service/api:lambda-auth-grants.json",
    "service/api/test/fixtures/wire": "//service/api:wire_goldens",
    "service/config/beta.json": "//service/config:beta.json",
    "service/config/gamma.json": "//service/config:gamma.json",
    "service/config/prod.json": "//service/config:prod.json",
    "service/infra/access/cfn-exec-policy.template.json": "//service/infra/access:cfn-exec-policy.template.json",
    "site/dist": "//site:dist",
    "site/src/routes.ts": "//site:routes.ts",
    "site/test/fixtures/routes.json": "//site:routes.json",
    "spec": "//:spec",
}

# cdk.json's app, `npx ts-node --prefer-ts-exts bin/stacks.ts`, without npx (there is no npm).
_APP = "node node_modules/.bin/ts-node --prefer-ts-exts bin/stacks.ts"

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    data = _DATA,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

jest_test(
    name = "test",
    data = _DATA,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# The lines and branches of the package's own code that the tests above reach (jest --coverage), held to coverage_floor.txt (vendor/buildrules_coverage/README.md).
jest_coverage_floor()

[cdk_synth(
    name = "synth_" + stage,
    app = _APP,
    context = {
        "commit": "ci",
        "hostedZoneId": "Z0DUMMYZONE",
        "stage": stage,
        "version": "ci",
    },
    data = _DATA,
    env = {
        "CDK_DEFAULT_ACCOUNT": "1" * 12,
        "CDK_DEFAULT_REGION": "us-east-1",
    },
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
) for stage in ["beta", "gamma", "prod"]]

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["cdk.out/**", "**/*.js", "**/*.d.ts", "cdk.context.json"]) + [".gitignore", "jest.config.js"],
    copy = True,
    visibility = ["//:"],
)

# The sources that name the queues and the alarms the runbook states (site/test/docs-group.test.ts).
[export_file(
    name = "site_" + name,
    src = path,
    mode = "reference",
    visibility = ["//site:"],
) for name, path in {
    "config.ts": "lib/config.ts",
    "publish-stack.ts": "lib/publish-stack.ts",
}.items()]
