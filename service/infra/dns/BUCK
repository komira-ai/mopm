# The DNS stacks' checks (see service/api/BUCK): `tsc --noEmit`, `jest --ci` (which includes the held dns command,
# tested against a fake host) and the four `cdk synth` runs of service-ci.yml with the same dummy values.

load("@buildrules//rules/node:modules.bzl", "cdk_synth", "npm_modules", "tsc_check")
load("//vendor/buildrules_coverage:jest_cover.bzl", "jest_coverage_floor", "jest_test")
load(":pins.lock.bzl", "NPM")

_NODE = "//tools/node:node"

_SRCS = glob(["bin/**", "lib/**", "test/**"]) + [
    "cdk.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

# cdk.json's app, `npx ts-node --prefer-ts-exts bin/dns.ts`, without npx (there is no npm).
_APP = "node node_modules/.bin/ts-node --prefer-ts-exts bin/dns.ts"

_ENV = {
    "CDK_DEFAULT_REGION": "us-east-1",
}

_ACCOUNT = "1" * 12

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

jest_test(
    name = "test",
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# The lines and branches of the package's own code that the tests above reach (jest --coverage), held to coverage_floor.txt (vendor/buildrules_coverage/README.md).
jest_coverage_floor()

# The zone of every stage.
[cdk_synth(
    name = "synth_" + stage,
    app = _APP,
    context = {
        "account": _ACCOUNT,
        "stage": stage,
    },
    env = _ENV,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
) for stage in ["beta", "gamma", "prod"]]

# The delegation, with dummy name servers.
cdk_synth(
    name = "synth_delegation",
    app = _APP,
    context = {
        "account": _ACCOUNT,
        "betaNameServers": "ns-11.awsdns-01.org,ns-12.awsdns-02.com,ns-13.awsdns-03.net,ns-14.awsdns-04.co.uk",
        "delegate": "true",
        "gammaNameServers": "ns-21.awsdns-01.org,ns-22.awsdns-02.com,ns-23.awsdns-03.net,ns-24.awsdns-04.co.uk",
        "hostedZoneId": "Z0DUMMYZONE",
        "stage": "prod",
    },
    env = _ENV,
    modules = ":modules",
    node = _NODE,
    srcs = _SRCS,
)

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["cdk.out/**", "**/*.js", "**/*.d.ts", "cdk.context.json"]) + [".gitignore", "jest.config.js"],
    copy = True,
    visibility = ["//:"],
)
