{
  "description": "A subdir outside the four is logged and nothing is written or invalidated; the invocation succeeds.",
  "lambda": "indexer",
  "env": {
    "MOPM_STAGE": "beta",
    "MOPM_CHANNEL_BUCKET": "channel-bucket",
    "MOPM_DISTRIBUTION_ID": "DIST1",
    "MOPM_INDEX_QUEUE_URL": "index-queue-url"
  },
  "invocations": [
    {
      "event": {
        "Records": [
          {
            "messageId": "m1",
            "receiptHandle": "handle-1",
            "body": "{\"type\":\"index\",\"subdir\":\"../evil\"}",
            "attributes": {
              "MessageGroupId": "g"
            },
            "messageAttributes": {},
            "eventSource": "aws:sqs"
          }
        ]
      },
      "expect": {
        "returns": null
      }
    }
  ],
  "expect": {
    "dynamo": [],
    "aws_http": [],
    "logs": [
      {
        "stream": "log",
        "line": {
          "level": "error",
          "msg": "index message for an unknown subdir",
          "subdir": "../evil"
        }
      },
      {
        "stream": "log",
        "line": {
          "level": "info",
          "msg": "index",
          "subdir": "../evil"
        }
      }
    ]
  }
}
