{
  "description": "A CI token is good for exactly its package and version: begin and commit at that version work as the CI identity, status is readable by it, and another version, another package or yank by it are scope_missing.",
  "world": {
    "auth": true,
    "publish": true,
    "seeds": [
      "auth_accounts"
    ]
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/files",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-alpha-2.0.0-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/files",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-alpha-2.0.0-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "put_object": {
        "upload_id": "{{0.upload_id}}",
        "content": "hello"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/publish",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "upload_ids": [
            "{{0.upload_id}}"
          ],
          "manifest_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      },
      "expect": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/publishes/{{3.publish_id}}",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.1/files",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-alpha-2.0.1-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 403,
        "code": "scope_missing"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/beta_pkg/2.0.0/files",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-beta_pkg-2.0.0-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 403,
        "code": "scope_missing"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/v1/packages/alpha/1.0.0/yank",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "yanked": true,
          "reason": "x"
        }
      },
      "expect": {
        "status": 403,
        "code": "scope_missing"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/v1/packages/alpha/2.0.0/yank",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "yanked": true,
          "reason": "x"
        }
      },
      "expect": {
        "status": 409,
        "code": "invalid_transition"
      }
    }
  ]
}
