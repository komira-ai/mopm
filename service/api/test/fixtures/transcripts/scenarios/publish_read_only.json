{
  "description": "Read-only mode: begin and commit are 503 read_only_mode for everyone, signed in or not, before the token is looked at; status and yank still work; the switch is read on every request.",
  "world": {
    "auth": true,
    "publish": true,
    "seeds": [
      "auth_accounts"
    ],
    "read_only": true
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/files",
        "token": "mopm_apifullaaaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-alpha-2.0.0-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 503,
        "code": "read_only_mode"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/files",
        "json": {
          "subdir": "noarch",
          "filename": "mojo-alpha-2.0.0-mojo1.0.0_0.conda",
          "sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "size": 5
        }
      },
      "expect": {
        "status": 503,
        "code": "read_only_mode"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/publish",
        "token": "mopm_apifullaaaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {}
      },
      "expect": {
        "status": 503,
        "code": "read_only_mode"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/packages/alpha/2.0.0/publish",
        "json": {}
      },
      "expect": {
        "status": 503,
        "code": "read_only_mode"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/publishes/pub_nosuch",
        "token": "mopm_apifullaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "status": 404,
        "code": "publish_not_found"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/v1/packages/alpha/1.0.0/yank",
        "token": "mopm_apifullaaaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "yanked": true,
          "reason": "incident"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages/alpha"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "set": {
        "read_only": false
