{
  "description": "sort=updated: newest publication first, claim time when nothing is published, the tie broken by name, and cursors that continue exactly.",
  "world": {
    "seeds": [
      "search_prefix_http"
    ]
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "updated"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "updated",
          "limit": "1"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "updated",
          "limit": "1",
          "cursor": "{{1.next_cursor}}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "updated",
          "limit": "1",
          "cursor": "{{2.next_cursor}}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "updated",
          "q": "http"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/packages",
        "query": {
          "sort": "name",
          "cursor": "{{1.next_cursor}}"
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    }
  ]
}
