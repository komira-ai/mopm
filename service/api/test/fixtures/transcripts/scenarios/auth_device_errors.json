{
  "description": "Login refusals: bodies that are not a valid start, unknown and short device codes, an expired login, GitHub failing, an account without two-factor.",
  "world": {
    "auth": true,
    "github": {
      "poll_script": [
        {
          "access_token": "gho_faketoken",
          "token_type": "bearer",
          "scope": "read:user"
        }
      ],
      "user": {
        "id": 4242,
        "login": "octo",
        "two_factor_authentication": false
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "body": ""
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "body": "not json"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "body": "[]"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "body": "null"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {}
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": ""
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": 5
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "body": {
          "$repeat": [
            "x",
            65537
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "short"
        }
      },
      "expect": {
        "status": 404,
        "code": "device_code_unknown"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      },
      "expect": {
        "status": 404,
        "code": "device_code_unknown"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      },
      "expect": {
        "status": 404,
        "code": "device_code_unknown"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {}
      },
      "expect": {
        "status": 404,
        "code": "device_code_unknown"
      }
    },
    {
      "set": {
        "advance_s": 6
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "{{10.device_code}}"
        }
      },
      "expect": {
        "status": 403
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": "mopm 0.1.0"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "set": {
        "advance_s": 601
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "{{16.device_code}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
