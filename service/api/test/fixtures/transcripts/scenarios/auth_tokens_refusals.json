{
  "description": "Creating a token: a stale session or an API token is stale_session, a CI token is nobody's, each invalid body member, the expiry bounds, and a package the caller does not own.",
  "world": {
    "auth": true,
    "publish": true,
    "seeds": [
      "auth_accounts"
    ]
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_sessstaleaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "name": "ci",
          "scopes": [
            "publish"
          ],
          "packages": [
            "alpha"
          ],
          "expires_in_days": 30
        }
      },
      "expect": {
        "status": 401,
        "code": "stale_session"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_apifullaaaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "name": "ci",
          "scopes": [
            "publish"
          ],
          "packages": [
            "alpha"
          ],
          "expires_in_days": 30
        }
      },
      "expect": {
        "status": 401,
        "code": "stale_session"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_ciwidgetsaaaaaaaaaaaaaaaaaaaaaaa",
        "json": {
          "name": "ci",
          "scopes": [
            "publish"
          ],
          "packages": [
            "alpha"
          ],
          "expires_in_days": 30
        }
      },
      "expect": {
        "status": 403,
        "code": "scope_missing"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "json": {
          "name": "ci"
        }
      },
      "expect": {
        "status": 401,
        "code": "token_missing"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_sessfreshaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_sessfreshaaaaaaaaaaaaaaaaaaaaaaa",
        "body": "not json"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_sessfreshaaaaaaaaaaaaaaaaaaaaaaa",
        "body": "[]"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/me/tokens",
        "token": "mopm_sessfreshaaaaaaaaaaaaaaaaaaaaaaa",
        "body": {
          "$repeat": [
            "x",
            65537
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      }
    },
    {
