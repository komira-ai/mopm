{
  "description": "A poll that GitHub answers with access_denied, and the login gone afterwards.",
  "world": {
    "auth": true,
    "github": {
      "poll_script": [
        {
          "error": "access_denied"
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device",
        "json": {
          "client": "mopm 0.1.0"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "set": {
        "advance_s": 6
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "{{0.device_code}}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/device/poll",
        "json": {
          "device_code": "{{0.device_code}}"
        }
      },
      "expect": {
        "status": 404,
        "code": "device_code_unknown"
      }
    }
  ]
}
