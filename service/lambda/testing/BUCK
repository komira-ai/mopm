# mopm_testing: in-memory adapters and the contract scenarios the real adapters are held to. Built from Cargo.toml by
# buildrules' cargo_package.
load("//:buildrules.bzl", "cargo_package")

# The web sign-in function's grants (tests/fixtures/web_login_grants.json): `fake_dynamo` reads them with `include_str!`
# from the library's sources, so they are an input of every compile of this crate, not only of its tests.
export_file(
    name = "web_login_grants.json",
    src = "tests/fixtures/web_login_grants.json",
    mode = "reference",
)

# The web session function's grants (tests/fixtures/web_session_grants.json), read the same way. The API stack's test
# (service/infra/stacks/test/web-session.test.ts) holds the function's role to the same file.
export_file(
    name = "web_session_grants.json",
    src = "tests/fixtures/web_session_grants.json",
    mode = "reference",
    visibility = ["//service/infra/stacks:"],
)

cargo_package(
    path = ".",
    extra_srcs = [":web_login_grants.json", ":web_session_grants.json"],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
