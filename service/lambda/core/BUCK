# mopm_core: the registry's rules that need no storage, no network and no clock (versions, the
# state machine of a version, canonical JSON, the channel index and its zstd frame, the error
# catalogue, the validator's limits, the display metadata rules), ported from the TypeScript
# registry (service/api/src) with its outputs held byte for byte. See README.md.
#
# The unit tests are welded into the library: building it runs them, and it is not published unless
# they passed. They read, as files, what the TypeScript side holds itself to: the repodata its index
# writer produced for the golden records, the error table of the API specification, and the rendered
# errors of the contract fixtures.
load("@komira//tools/build/rust:defs.bzl", "rust_library", "rust_test")

_DEPS = [
    "//third_party/rust:serde",
    "//third_party/rust:serde_json",
    "//third_party/rust:thiserror",
    "//third_party/rust:url",
]

_SRCS = glob(["src/*.rs"])

# Files of other packages, by label: they land at their package-relative path beside src/, which is
# where the include_str! of the tests reaches them.
_GOLDEN = [
    "//:lambda.contract.errors.json",
    "//:lambda.spec.openapi.yaml",
    "//service/api:repodata.linux-64.json",
    "//service/api:repodata.noarch.json",
    "//service/api:repodata.osx-arm64.json",
]

rust_test(
    name = "mopm_core_unit",
    srcs = _SRCS + _GOLDEN,
    crate_root = "src/lib.rs",
    deps = _DEPS + ["//third_party/rust:ruzstd"],
)

rust_library(
    name = "mopm_core",
    srcs = _SRCS,
    crate_root = "src/lib.rs",
    deps = _DEPS,
    tests = [":mopm_core_unit"],
    visibility = ["PUBLIC"],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
