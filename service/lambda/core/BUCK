# mopm_core: the registry's rules that need no storage, no network and no clock (versions, the
# state machine of a version, canonical JSON, the channel index and its zstd frame, the error
# catalogue, the validator's limits, the display metadata rules), ported from the TypeScript
# registry (service/api/src) with its outputs held byte for byte. See README.md.
#
# Built from Cargo.toml by buildrules' cargo_package (the front door of the cargo_unit engine): `:lib`, `:test`, `:lint`,
# `:debug`, `:release`. The unit tests run as build actions (`:test`; `:debug` does not wait for them, `:ci` does both).
# They read, as files, what the TypeScript side holds itself to: the repodata its index writer produced for the golden
# records, the error table of the API specification, and the rendered errors of the contract fixtures. The sources
# `include_str!` them at their real paths, so `cargo test` finds them too; `extra_srcs` makes them inputs.
load("//:buildrules.bzl", "cargo_package")

cargo_package(
    path = ".",
    extra_srcs = [
        "//:lambda.spec.openapi.yaml",
        "//:lambda.contract.errors.json",
        "//service/api:repodata.linux-64.json",
        "//service/api:repodata.noarch.json",
        "//service/api:repodata.osx-arm64.json",
    ],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
