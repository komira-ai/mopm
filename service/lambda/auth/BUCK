# mopm_auth: tokens, device login, GitHub (the OAuth device flow and the user lookup), and the exchange of a
# CI identity token (OIDC) for a publish token. Logic over the ports (mopm_ports); the HTTP client is the one
# outbound seam. Written to hold the answers of service/api/src/auth.
load("@komira//tools/build/rust:defs.bzl", "rust_library", "rust_test")

AWS_LC = "komira//third_party/aws-lc:crypto[static-pic]"

_DEPS = [
    "//service/lambda/core:mopm_core",
    "//service/lambda/ports:mopm_ports",
    "//third_party/rust:base64-0.23.1",
    "//third_party/rust:form_urlencoded",
    "//third_party/rust:getrandom-0.4.3",
    "//third_party/rust:hex",
    "//third_party/rust:http-body-util",
    "//third_party/rust:hyper",
    "//third_party/rust:hyper-rustls",
    "//third_party/rust:hyper-util",
    "//third_party/rust:jiff",
    "//third_party/rust:jsonwebtoken",
    "//third_party/rust:rustls",
    "//third_party/rust:serde",
    "//third_party/rust:serde_json",
    "//third_party/rust:sha2-0.11.0",
    "//third_party/rust:subtle",
    "//third_party/rust:thiserror",
    "//third_party/rust:tokio",
]

rust_test(
    name = "mopm_auth_unit",
    srcs = glob(["src/*.rs"]),
    crate_root = "src/lib.rs",
    deps = _DEPS + ["//service/lambda/testing:mopm_testing"],
    native_deps = [AWS_LC],
)

rust_library(
    name = "mopm_auth",
    srcs = glob(["src/*.rs"]),
    crate_root = "src/lib.rs",
    deps = _DEPS,
    tests = [":mopm_auth_unit"],
    visibility = ["PUBLIC"],
)

filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
