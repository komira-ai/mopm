# mopm_validate: the package validator, ported from service/api/src/validate. Pure: bytes in, verdict out.
# Its tests are `:test`, among them the replay of the validator corpus (tests/validator_corpus,
# komira-ai/mopm#88): the Rust verdict of every one of its 220 inputs must equal the one the TypeScript gave. The
# corpus is a directory of the root package that the sources `include_bytes!` at its real path.
load("//:buildrules.bzl", "cargo_package")

cargo_package(
    path = ".",
    extra_srcs = ["//:validator_corpus_dir"],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
