# mopm_validate: the package validator, ported from service/api/src/validate. Pure: bytes in, verdict out.
# Its tests are welded into the library, among them the replay of the validator corpus (tests/validator_corpus,
# komira-ai/mopm#88): the Rust verdict of every one of its 217 inputs must equal the one the TypeScript gave.
load("@komira//tools/build/rust:defs.bzl", "rust_library", "rust_test")

_DEPS = [
    "//service/lambda/core:mopm_core",
    "//third_party/rust:crc32fast",
    "//third_party/rust:flate2",
    "//third_party/rust:hex",
    "//third_party/rust:ruzstd",
    "//third_party/rust:serde",
    "//third_party/rust:serde_json",
    "//third_party/rust:sha2-0.11.0",
    "//third_party/rust:unicode-normalization",
]

_SRCS = glob(["src/*.rs"])

rust_test(
    name = "mopm_validate_unit",
    # The corpus is a directory of the root package, staged beside src/ as `validator_corpus_files/`.
    srcs = _SRCS + ["//:validator_corpus_files"],
    crate_root = "src/lib.rs",
    deps = _DEPS,
)

rust_library(
    name = "mopm_validate",
    srcs = _SRCS,
    crate_root = "src/lib.rs",
    deps = _DEPS,
    tests = [":mopm_validate_unit"],
    visibility = ["PUBLIC"],
)

filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
