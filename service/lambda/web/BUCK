# mopm_web: what the website's three functions share (cookies, the edge-header, session and CSRF checks, the error
# envelope, the API Gateway adapter, the stage and its settings). Built from Cargo.toml by buildrules' cargo_package. See
# README.md.
#
# The error envelope's test reads the website's contract examples (tests/contract/api-v2/web-auth.json and
# tutorial-sandbox.json) with `include_str!` at their real paths, so `cargo test` finds them too; `extra_srcs` makes them
# inputs, and a contract example this crate does not answer byte for byte is a red build here.
load("//:buildrules.bzl", "cargo_package")

cargo_package(
    path = ".",
    extra_srcs = [
        "//:lambda.contract.v2.web-auth.json",
        "//:lambda.contract.v2.tutorial-sandbox.json",
    ],
)

# The stage_settings item as the API stack writes it (tests/fixtures/stage_settings_item.json, DynamoDB JSON): the stack's
# test (service/infra/stacks/test/stage-settings.test.ts) holds its writer to it, and the tests of fn_web_session and
# fn_tutorial_sandbox read it through the DynamoDB config adapter into StageSettings.
export_file(
    name = "stage_settings_item.json",
    src = "tests/fixtures/stage_settings_item.json",
    mode = "reference",
    visibility = ["//service/infra/stacks:", "//service/lambda/fn_tutorial_sandbox:", "//service/lambda/fn_web_session:"],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)

# The constants docs/what-mopm-stores.md states (site/test/docs-stores.test.ts reads them).
export_file(
    name = "site_cookie.rs",
    src = "src/cookie.rs",
    mode = "reference",
    visibility = ["//site:"],
)
export_file(
    name = "site_session.rs",
    src = "src/session.rs",
    mode = "reference",
    visibility = ["//site:"],
)
