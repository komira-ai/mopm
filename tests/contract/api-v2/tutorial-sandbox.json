          "envd_version": "0.4.2",
          "domain": "e2b.app",
          "expires_at": "2026-11-19T12:30:00.000Z"
        }
      }
    },
    {
      "name": "a sandbox request from a signed-out browser is refused as session_required",
      "operationId": "createTutorialSandbox",
      "request": {},
      "response": {
        "status": 401,
        "headers": {
          "x-mopm-request-id": "req-7f3a2c19d0e4"
        },
        "body": {
          "error": {
            "code": "session_required",
            "message": "You are not signed in to the website.",
            "hint": "Sign in with GitHub, then try again."
          }
        }
      }
    },
    {
      "name": "a sandbox request with a wrong CSRF value is refused as csrf_failed",
      "operationId": "createTutorialSandbox",
      "request": {
        "auth": "webSession"
      },
      "response": {
        "status": 403,
        "headers": {
          "x-mopm-request-id": "req-7f3a2c19d0e4"
        },
        "body": {
          "error": {
            "code": "csrf_failed",
            "message": "The request did not come from a page of the website.",
            "hint": "Reload the page and try again."
          }
        }
      }
    },
