name: farm
on:
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  build:
    if: always()
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - uses: komira-ai/komira/.github/actions/farm-connect@4acb7348f39997a86dd80012f6f39ed221334b91
        with:
          farm-address: ${{ vars.FARM_ADDRESS }}
      - run: ./buck2 build //...
