# The registry end-to-end tests: the built CLI against the fake registry, driven
# by the Python scripts beside this file (standard library only), as
# `python3 -I tests/registry_e2e/<script> <mopm> <mopm-fake-registry>` in ci.yml.
# Both servers listen on loopback, port 0: the action needs the loopback
# interface up and nothing else of the network.
#
# ASSUMED, not yet checked against the komira commit .buckconfig pins:
#   script_test(srcs, tools, cmd): srcs are present at their repository-relative
#   paths in the working directory; each tool's name is an environment
#   variable holding its path; a directory tool (python_dist) holds bin/python3.
#   The pinned Python is komira//tools/build/toolchains:python.

load("@komira//tools/build/mojo:toolchain.bzl", "script_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

_TOOLS = {
    "FAKE_REGISTRY": "//:mopm-fake-registry",
    "MOPM": "//:mopm",
    "PYTHON": "komira//tools/build/toolchains:python",
}

script_test(
    name = "login",
    srcs = ["run.py"],
    tools = _TOOLS,
    cmd = '"$PYTHON/bin/python3" -I tests/registry_e2e/run.py "$MOPM" "$FAKE_REGISTRY"',
    busybox = "komira//tools/build/toolchains:busybox",
    exec_compatible_with = LINUX_X86_64,
)

script_test(
    name = "publish",
    srcs = ["publish.py"],
    tools = _TOOLS,
    cmd = '"$PYTHON/bin/python3" -I tests/registry_e2e/publish.py "$MOPM" "$FAKE_REGISTRY"',
    busybox = "komira//tools/build/toolchains:busybox",
    exec_compatible_with = LINUX_X86_64,
)
