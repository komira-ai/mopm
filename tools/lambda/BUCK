# Lambda packaging: the deployment package of a custom-runtime function (`bootstrap`
# in a zip), written and read back by Zig tools, so no build or test action uses a shell
# of its own. See README.md.
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_test")
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("//:buildrules.bzl", "cargo_package")
load(":lambda.bzl", "lambda_zip")

_TOOLS = {
    "busybox": "buildrules//rules/pins:busybox",
    "exec_compatible_with": LINUX_X86_64,
    "zig": "buildrules//rules/pins:zig",
}

zig_exe(
    name = "zip_pack",
    src = "zip_pack.zig",
    unit_tests = [":zip_pack_test"],
    visibility = ["PUBLIC"],
    **_TOOLS
)

zig_test(
    name = "zip_pack_test",
    src = "zip_pack.zig",
    **_TOOLS
)

zig_exe(
    name = "zip_check",
    src = "zip_check.zig",
    unit_tests = [":zip_check_test"],
    visibility = ["PUBLIC"],
    **_TOOLS
)

zig_test(
    name = "zip_check_test",
    src = "zip_check.zig",
    **_TOOLS
)

# ---- The canary
#
# The canary: a Lambda function built from the pinned crates (Cargo.toml, third_party/buildrules) with buildrules' cargo_unit
# rules, to hold the build foundation of the registry's Rust functions. Nothing deploys it. Built from Cargo.toml by
# `cargo_package` (this package is a Cargo package, `mopm_canary`: the executable `canary`, and the integration tests
# `tls_test` and `sdk_test`):
#
#   :release           the function's executable (`bootstrap`), the release profile
#   :test              the unit tests of main.rs, :tls_test and :sdk_test, one marker each
#   :canary_e2e_test   runs the release executable against a fake Lambda runtime API on loopback and holds its answer
#   :canary_zip        the deployment package; not built unless :test and :canary_e2e_test passed on that binary
#
#   canary/tls_test.rs rustls on aws-lc-rs over buildrules' AWS-LC: handshakes, a refused name, the version
#   canary/sdk_test.rs the AWS SDK for Rust: one DynamoDB GetItem on loopback, and a client of each service
#
# aws-lc-sys is not built from its C sources: third_party/buildrules/overrides.json links buildrules' AWS-LC into each test
# and executable. See tools/lambda/README.md.
cargo_package(path = ".")

zig_test(
    name = "canary_e2e_test",
    src = "canary/e2e_test.zig",
    env_tools = {"BOOTSTRAP": ":release"},
    busybox = "buildrules//rules/pins:busybox",
    exec_compatible_with = LINUX_X86_64,
    zig = "buildrules//rules/pins:zig",
)

lambda_zip(
    name = "canary_zip",
    bootstrap = ":release",
    welded_tests = [":canary_e2e_test", ":test"],
    visibility = ["PUBLIC"],
)

# This package's files, for //:hygiene (a package boundary hides them from the root package's glob).
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
