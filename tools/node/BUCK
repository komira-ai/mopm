# The Node.js the service tests and the site run on (service/*/BUCK, site/BUCK): komira's node_dist over a
# release archive pinned by kpin (pins.toml, pins.lock.bzl). komira's rules are loaded once
# per cell, so a provider from komira's own node_dist target is not this repository's
# (facebook/buck2#683): this repository declares its own, and passes it to the rules as
# `node =`. It is the same archive, sha256 and C++ runtime as komira's third_party/node.

load("@buildrules//rules/kpin:pins.bzl", "pin_kwargs", "pin_version")
load("@buildrules//rules/core:pinned_file.bzl", "pinned_file")
load("@buildrules//rules/zig:zig.bzl", "conda_libs")
load("@buildrules//rules/node:defs.bzl", "node_dist")
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load(":pins.lock.bzl", "PINS")

_VERSION = pin_version(PINS, "node")

pinned_file(**pin_kwargs(PINS, "node", "linux-x64", name = "node.tar.gz"))

# The C++ runtime `node` links beyond glibc: the conda-forge packages pinned in
# buildrules//rules/pins.
conda_libs(
    name = "native_libs",
    exec_compatible_with = LINUX_X86_64,
    libs = {
        "lib/libgcc_s.so.1": "buildrules//rules/pins:libgcc_15.3.0_linux-64.conda",
        "lib/libstdc++.so.6": "buildrules//rules/pins:libstdcxx_15.3.0_linux-64.conda",
    },
    unpacker = "buildrules//rules/zig:conda_unpack",
)

node_dist(
    name = "node",
    archive = ":node.tar.gz",
    native_libs = ":native_libs",
    top = "node-v{}-linux-x64".format(_VERSION),
    version = _VERSION,
    visibility = ["//service/...", "//site:"],
)

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"]) + [],
    copy = True,
    visibility = ["//:"],
)
