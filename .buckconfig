# Buck2 configuration of mopm: komira's build rules, with komira fetched as a
# git external cell. This is komira's tools/build/consumer.buckconfig with the
# root cell named `mopm`; see that file for what each section is for.
#
# The cell must be called `komira`: output paths contain the cell name, and
# keeping it gives komira's toolchain actions the same digests as in a
# komira checkout, so both share remote-cache entries.
#
# Two directories here are copies from komira:
#   toolchains/BUCK  from tools/build/cells/toolchains/BUCK
#   platforms/BUCK   from tools/build/platforms/default/BUCK
# and `buck2` / `tools/buck2` are komira's, byte for byte: the same buck2
# release as komira's, so the actions are keyed alike.
#
# Remote execution is not configured here: no endpoint or worker property
# set belongs in this public repository. Without any, every action runs on
# the machine that runs buck2. A farm's settings go in `.buckconfig.local`
# (gitignored), or, in CI, in the file the farm-connect step writes
# (.github/workflows/farm.yml).

[cells]
  mopm = .
  prelude = prelude
  toolchains = toolchains
  # A git external cell needs no directory here; nothing is checked out at this path.
  komira = komira-ext
  buildrules = buildrules-ext
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none
  # komira aefee5326 names its own tests cell in a few visibility lists; the alias
  # makes those patterns resolve (to packages that are not there). Nothing is built from it.
  tests = komira

[external_cells]
  prelude = bundled
  komira = git
  buildrules = git

[external_cell_komira]
  git_origin = https://github.com/komira-ai/komira.git
  # komira, kept for the Mojo compiler of the end-to-end tests (komira//tools/build/toolchains:mojo_compiler): the Zig,
  # node, C/C++ and Rust rules, and AWS-LC, are buildrules'. Bump it with farm.yml.
  # aefee5326: komira main at the merge of komira-ai/komira#2094, whose farm-connect gives a farm PING 60 s
  # to come back and sends at most 4 blobs of an action at once (a slow farm connection is no longer dropped
  # with KeepAliveTimedOut).
  commit_hash = aefee53266277c55b40ccbf35782a296ceecf687

[external_cell_buildrules]
  # buildrules: its Rust (cargo_unit, the cargo_package front door), Zig, node, cxx, coverage and AWS-LC rules and the CLI.
  # Bump commit_hash to take a newer commit. da5248c55: buildrules main at the merge of komira-ai/buildrules#159 (the pinned
  # rustfmt, `:fmt` per cargo member and `//:fmt`, which Cargo.toml's `ci` action builds).
  git_origin = https://github.com/komira-ai/buildrules.git
  commit_hash = da5248c55edc165dfa79a345115515f490dde90a

# The farm's macOS arm64 workers, for buildrules, which reads every `[buildrules_re]` key from this (the root) cell. farm-connect
# writes the worker property set and the hosts under `[komira_re]` (farm-macos.yml passes them); these keys follow them, holding no
# value of their own, so a build with no macOS workers (every farm.yml build) leaves them empty and registers no macOS execution
# platform (platforms/macos.bzl, `macos_gate`). This is the passthrough of komira's own .buckconfig.
# farm-connect writes the linux worker property set under `[komira_re]` too; mapped here, a CI job needs no step to copy it. A
# .buckconfig.local that sets `[buildrules_re] linux_x86_64_properties` (a developer's, or farm.yml's appended section) overrides it.
# With neither the key is empty: buildrules' remote mode refuses to load the platform (rules/platforms.bzl `_properties`: "is not
# set"), and local mode (`-c buildrules_re.mode=local`) still runs, its check being only for a non-empty value.
[buildrules_re]
  linux_x86_64_properties = $(config komira_re.linux_x86_64_properties)
  macos_aarch64_properties = $(config komira_re.darwin_arm64_properties)
  darwin_macos_hosts = $(config komira_re.darwin_macos_hosts)

[buildfile]
  name = BUCK

[parser]
  target_platform_detector_spec = target:mopm//...->mopm//platforms:linux_x86_64 target:komira//...->mopm//platforms:linux_x86_64 target:buildrules//...->mopm//platforms:linux_x86_64 target:toolchains//...->mopm//platforms:linux_x86_64

[build]
  execution_platforms = mopm//platforms:default

[buck2_re_client]
  max_total_batch_size = 1048576

[komira]
  # The timeout of buck2's test runner, as in komira's .buckconfig.
  test_timeout_s = 600

[project]
  ignore = buck-out, .git, .zig-cache, **/node_modules
