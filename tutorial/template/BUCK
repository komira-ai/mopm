# The tutorial's E2B template (README.md): its checks, run on the farm from the pinned npm packages
# (buildrules.lock.bzl, from package-lock.json by `buildrules npm sync`) with buildrules' npm_package:
# the steps are package.json's own scripts, `npm run typecheck` and `npm test`. No install, no script,
# no network. The held build command (`npm run template`) is never a target: an operator runs it.
# Written once by `buildrules npm sync`; yours after that.
load(":buildrules.bzl", "npm_package")
load("@buildrules//rules/node:modules.bzl", "jest_test")
load("@buildrules//rules/coverage:jest_cover.bzl", "jest_coverage_floor")

_NODE = "//tools/node:node"

# The tests read the repository's VERSION and every lesson under tutorial/lessons (test/fixture.ts's
# REPO_ROOT), at their paths in the repository.
_TEST_DATA = {
    "VERSION": "//:tutorial_template.VERSION",
    "tutorial/lessons": "//:tutorial_template_lessons",
}

npm_package(
    path = ".",
    node = _NODE,
    exclude = ["README.md"],
    step_data = {"test": _TEST_DATA},
)

# `jest --ci --coverage` over the same tree, data and config as `:test`: the target is the coverage directory.
# npm_package's `:test` is a pass marker and does not write one, so the floor reads this run instead.
jest_test(
    name = "coverage_run",
    coverage = True,
    data = _TEST_DATA,
    modules = ":node_modules",
    node = _NODE,
    srcs = glob(["src/**", "test/**"]) + [
        "build.ts",
        "jest.config.js",
        "package.json",
        "tsconfig.json",
    ],
)

# The lines and branches of the package's own code that the tests reach (jest --coverage), held to coverage_floor.txt (buildrules' rules/coverage/README.md).
jest_coverage_floor(coverage = ":coverage_run")

# This package's files, for //:hygiene (the repository-wide scan reads every file, and a
# package boundary hides these from the root package's glob). A copy of the tree, staged
# by path from this package.
filegroup(
    name = "lint_files",
    srcs = glob(["**"], exclude = ["build/**", "coverage/**", "node_modules/**"]) + [".gitignore"],
    copy = True,
    visibility = ["//:"],
)
