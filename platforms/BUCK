load("@buildrules//rules:platforms.bzl", "buildrules_execution_platforms")

# One platform that is linux x86_64 for both rule sets: buildrules' constraints (zig, node, rust
# rules) and the prelude's, which komira's Mojo toolchain and AWS-LC (kept on komira) use. It is the target
# platform of every cell (.buckconfig [parser]) and the configuration of the execution platform.
platform(
    name = "linux_x86_64",
    constraint_values = [
        "buildrules//platforms:linux",
        "buildrules//platforms:x86_64",
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

buildrules_execution_platforms(
    name = "default",
    linux_x86_64 = ":linux_x86_64",
    visibility = ["PUBLIC"],
)
