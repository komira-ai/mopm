{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/lock-1.json",
  "title": "mopm.lock",
  "description": "The resolved closure of a project. JSON. Written by mopm, committed, never edited by hand. Semantic rules that JSON Schema cannot express are in spec/lock.md and checked by tests/contract/validate.py.",
  "type": "object",
  "required": ["lock_version", "toolchain", "channels", "packages"],
  "properties": {
    "lock_version": { "const": 1 },
    "toolchain": {
      "type": "object",
      "required": ["mojo"],
      "properties": {
        "mojo": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([a-z0-9.]*)$" }
      }
    },
    "channels": {
      "description": "The channels packages may come from: the root project's set, nothing else.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[^/]+/$" }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "build", "subdir", "channel", "url", "sha256", "size", "mojo"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*((a|b|rc|dev)(0|[1-9][0-9]*))?$"
          },
          "build": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" },
          "subdir": { "enum": ["linux-64", "linux-aarch64", "osx-arm64", "noarch"] },
          "channel": { "type": "string", "pattern": "^https://[^/]+/$" },
          "url": { "type": "string", "pattern": "^https://[^/]+/.+\\.conda$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "mojo": {
            "description": "The Mojo version this build was made with.",
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([a-z0-9.]*)$"
          },
          "deps": {
            "description": "Names of direct Mojo dependencies; each must be in packages.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
          },
          "native": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "soname"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "soname": { "type": "string", "pattern": "^lib[^./]+\\..+$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
