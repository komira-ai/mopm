{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/lock-3.json",
  "title": "mopm.lock",
  "description": "The resolved closure of a project, lock_version 3. JSON. Written by mopm, committed, never edited by hand. A lock_version 1 or 2 file predates namespaces and is reported stale. Semantic rules that JSON Schema cannot express are in spec/lock.md and checked by the //:contract target (tests/drivers/contract.zig).",
  "$defs": {
    "FullName": {
      "description": "<namespace>/<name>: the namespace is a GitHub login in lower case, at most 39 characters; the name is what Mojo code imports.",
      "type": "string",
      "maxLength": 104,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z][a-z0-9_]{1,63}$"
    },
    "MojoVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([a-z0-9.]*)$" }
  },
  "type": "object",
  "required": ["lock_version", "mojo", "toolchain", "channels", "packages"],
  "properties": {
    "lock_version": { "const": 3 },
    "mojo": {
      "description": "The Mojo versions locked, sorted as byte strings, with no repeats. mopm sync installs the builds for the first.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/MojoVersion" }
    },
    "toolchain": {
      "description": "The closure hash of mopm's pinned toolchain for each locked Mojo version (the keys) and subdir (the inner keys). A Mojo version mopm pins no toolchain for has no entry.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "channels": {
      "description": "The channel roots packages may come from: the root project's set, nothing else. Each ends with '/' and may carry a path; https, or loopback http (127.0.0.1, [::1], localhost, port required) for local and test registries only.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(https://[^/]+|http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/([^?#\\s]*/)?$" }
    },
    "packages": {
      "description": "One entry per package version per subdir, sorted by name, then version, then subdir.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "$ref": "#/$defs/FullName" },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*((a|b|rc|dev)(0|[1-9][0-9]*))?$"
          },
          "source": { "description": "Present only on a path dependency.", "const": "path" },
          "path": { "description": "A path dependency's directory, relative to the project.", "type": "string", "minLength": 1 },
          "subdir": { "enum": ["linux-64", "linux-aarch64", "osx-arm64", "noarch"] },
          "channel": {
            "description": "A root of channels followed by the package's namespace and '/'.",
            "type": "string",
            "pattern": "^(https://[^/]+|http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/([^?#\\s]*/)?$"
          },
          "artifacts": {
            "description": "The builds, keyed by the Mojo version each was built with; every key is in mojo.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["build", "url", "sha256", "size"],
              "properties": {
                "build": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" },
                "url": { "description": "<channel><subdir>/mojo-<namespace>.<name>-<version>-<build>.conda", "type": "string", "pattern": "^(https://[^/]+|http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))/.+\\.conda$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "size": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "deps": {
            "description": "Full names of direct Mojo dependencies; each must be in packages.",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/FullName" }
          },
          "loads": {
            "description": "Conda names of the system libraries the package loads at run time, sorted; each is pinned in system_libs for the entry's subdir.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          },
          "native": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "soname"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "soname": { "type": "string", "pattern": "^lib[^./]+\\..+$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "kind": { "enum": ["shared", "static", "both"], "default": "shared" },
                "needs": { "type": "array", "items": { "type": "string" } },
                "exclusive": { "type": "string", "minLength": 1 },
                "link": {
                  "description": "System libraries the final link of a consumer adds, as -l<name> after every archive. Only a static library has them.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["c++", "dl", "m", "pthread"] }
                }
              }
            }
          }
        },
        "if": { "required": ["source"] },
        "then": { "required": ["path"] },
        "else": { "required": ["subdir", "channel", "artifacts"] }
      }
    },
    "system_libs": {
      "description": "The conda packages of the system libraries that manifests and registry packages load, per subdir (the keys), each list sorted by name. Left out when nothing is loaded.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "version", "build", "url", "sha256", "size"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" },
            "url": { "type": "string", "pattern": "^https://[^/]+/.+\\.conda$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1 },
            "deps": {
              "description": "Names of the entries of the same list this one needs to run.",
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
            }
          }
        }
      }
    }
  }
}
