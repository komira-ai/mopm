{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/index-config-1.json",
  "title": "mopm index config (/index/config.json)",
  "description": "Read first by the CLI. A CLI that does not know index_version refuses the index.",
  "type": "object",
  "required": [
    "index_version",
    "stage",
    "api_url",
    "channel_url",
    "min_cli_version"
  ],
  "properties": {
    "index_version": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "beta",
        "gamma",
        "prod"
      ]
    },
    "api_url": {
      "type": "string",
      "description": "https API root ending in /api/v1, or loopback http (127.0.0.1, [::1], localhost, port required) for local and test registries only.",
      "anyOf": [
        {
          "pattern": "^https://[^/]+/api/v1$"
        },
        {
          "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/api/v1$"
        }
      ]
    },
    "channel_url": {
      "type": "string",
      "description": "Base URL ending in '/': https conda.<host>, or loopback http (port required, any path) for local and test registries only.",
      "anyOf": [
        {
          "pattern": "^https://conda\\.[^/]+/$"
        },
        {
          "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/([^?#\\s]*/)?$"
        }
      ]
    },
    "min_cli_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "read_only": {
      "type": "boolean"
    }
  }
}
