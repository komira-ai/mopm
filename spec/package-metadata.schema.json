{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/package-metadata-1.json",
  "title": "mopm package metadata (<name>.mopm.json)",
  "type": "object",
  "required": ["schema", "name"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "description": "The package version, MAJOR.MINOR.PATCH. When present it must equal the version being published.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "deps": {
      "description": "Direct Mojo dependencies.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "range": {
            "description": "The requirement from mopm.toml, cargo syntax, copied verbatim (spec/mopm-toml.md, Version requirements).",
            "type": "string"
          },
          "path": {
            "description": "A local path, for co-development. A dependency with a path must also have a range: publish refuses a path without a version.",
            "type": "string"
          }
        },
        "dependentRequired": { "path": ["range"] }
      }
    },
    "native": {
      "description": "Native libraries this package ships.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "soname"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "soname": {
            "description": "Library file name, lib<name>.<suffix>.",
            "type": "string",
            "pattern": "^lib[^./]+\\..+$"
          },
          "kind": { "enum": ["shared", "static", "both"], "default": "shared" },
          "mode": { "enum": ["link", "load"], "default": "link" },
          "file": {
            "description": "Shared object, relative to this file. Required for kind shared and both.",
            "type": "string"
          },
          "static_file": {
            "description": "Static archive, relative to this file. Required for kind static and both.",
            "type": "string"
          },
          "needs": {
            "description": "Sonames of native libraries from other packages this one needs.",
            "type": "array",
            "items": { "type": "string" }
          },
          "exclusive": {
            "description": "An exclusivity group: a closure links at most one native library of a group.",
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["shared", "both"] } } },
            "then": { "required": ["file"] }
          },
          {
            "if": { "required": ["kind"], "properties": { "kind": { "enum": ["static", "both"] } } },
            "then": { "required": ["static_file"] }
          }
        ]
      }
    }
  }
}
