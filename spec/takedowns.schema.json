{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/takedowns-1.json",
  "title": "mopm takedown log (/index/takedowns.json)",
  "description": "Public log of versions whose bytes were removed. Append only.",
  "type": "object",
  "required": ["index_version", "takedowns"],
  "properties": {
    "index_version": { "type": "integer", "minimum": 1 },
    "takedowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "reason_code", "sha256", "date"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "version": { "type": "string", "minLength": 1 },
          "reason_code": { "type": "string", "minLength": 1 },
          "sha256": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
          "date": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
