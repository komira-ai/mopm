{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopm.dev/schema/index-record-2.json",
  "title": "mopm sparse index record, version 2 (one line of /index/v2/<aa>/<bb>/<namespace>/<name>)",
  "description": "One published version of one package. A package file is newline-delimited JSON: one record per line, every line with the same name, the full name <namespace>/<name> of the file. Unknown keys are ignored; a v this reader does not know is refused.",
  "$defs": {
    "FullName": { "type": "string", "maxLength": 104, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z][a-z0-9_]{1,63}$" },
    "File": {
      "type": "object",
      "required": ["subdir", "filename", "sha256", "size"],
      "properties": {
        "subdir": { "enum": ["linux-64", "linux-aarch64", "osx-arm64", "noarch"] },
        "filename": { "description": "mojo-<namespace>.<name>-<version>-<build>.conda: the conda name of the record's name, then its version and build.", "type": "string", "pattern": "^mojo-[a-z0-9]+(-[a-z0-9]+)*\\.[a-z][a-z0-9_]{1,63}-[0-9][0-9a-z.]*-[A-Za-z0-9_.]+\\.conda$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "url": { "description": "<channel_url><namespace>/<subdir>/<filename>.", "type": "string", "format": "uri" }
      }
    }
  },
  "type": "object",
  "required": ["v", "name", "version", "build", "state", "published_at", "requires_mojo", "deps", "files", "manifest_sha256"],
  "properties": {
    "v": { "const": 2 },
    "name": { "$ref": "#/$defs/FullName" },
    "version": {
      "description": "MAJOR.MINOR.PATCH: three numbers, no leading zeros, no pre-release or other suffix.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "build": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" },
    "state": { "enum": ["published", "yanked", "tombstoned"] },
    "yank_reason": { "type": "string", "minLength": 1, "maxLength": 280 },
    "tombstone": {
      "type": "object",
      "required": ["reason_code", "date"],
      "properties": {
        "reason_code": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" }
      }
    },
    "published_at": { "type": "string", "format": "date-time" },
    "requires_mojo": { "type": "string", "minLength": 1 },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/FullName" },
          "range": { "type": "string" }
        }
      }
    },
    "native": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "soname"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "soname": { "type": "string", "minLength": 1 }
        }
      }
    },
    "files": {
      "description": "The files of the primary build (the first of `builds`: the lowest compiler), which a reader that does not know `builds` reads as the version's files.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/File" }
    },
    "builds": {
      "description": "Every build of the version, one per Mojo compiler, sorted by compiler version (numerically, part by part: 1.2.0 before 1.10.0). A build is the files built with one compiler; its `build` is mojo<compiler>_0, which ends each of its file names, and no build and no compiler repeats. The first is the primary build: `build`, `requires_mojo` and `files` above are its. A reader that knows `builds` uses it and ignores those three; one that does not ignores this key and sees the primary build only. `deps`, `native`, `manifest_sha256`, `state`, `published_at` and the rest are the version's and are the same for every build. The registry writes `builds` on every record, also for a version with one build. Absent: the version has the one build that `build`, `requires_mojo` and `files` describe.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["build", "requires_mojo", "files"],
        "properties": {
          "build": { "type": "string", "pattern": "^mojo[0-9]+(\\.[0-9]+)*_0$" },
          "requires_mojo": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/File" } }
        }
      }
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["none", "oidc"] },
        "repository": { "type": "string" },
        "workflow_ref": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "yanked" } }, "required": ["state"] },
      "then": { "required": ["yank_reason"] }
    },
    {
      "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
      "then": { "required": ["tombstone"] },
      "else": {
        "properties": {
          "files": { "items": { "required": ["url"] } },
          "builds": { "items": { "properties": { "files": { "items": { "required": ["url"] } } } } }
        }
      }
    }
  ]
}
